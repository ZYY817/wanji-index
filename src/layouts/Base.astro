---
import { withBase } from '../lib/url.mjs';
import '../styles/base.css';
import site from '../../config/site.json'; // JSON import 打包为数据；字段校验在 astro.config 构建入口完成
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  wide?: boolean; // 索引页 1120（默认详情/文档 800）
}
const { title, description, noindex, wide } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title === site.name ? title : `${title} | ${site.name}`}</title>
  {description && <meta name="description" content={description} />}
  {noindex && <meta name="robots" content="noindex,follow" />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
</head>
<body>
  <Header />
  <main class:list={['container', wide ? 'container-index' : 'container-doc']}>
    <slot />
  </main>
  <Footer />
</body>
</html>
