---
import { withBase } from '../../lib/url.mjs';
// 游戏库 /games/ —— docs/05 §7.2 索引页通式：页内搜索+筛选+排序+索引行+空态
// 客户端筛选由 src/client/list-filter.js 驱动，URL 参数可恢复（docs/03）
import Base from '../../layouts/Base.astro';
import IndexRow from '../../components/IndexRow.astro';
import TextCover from '../../components/TextCover.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import EmptyState from '../../components/EmptyState.astro';
import { loadData, buildRelations } from '../../lib/load.mjs';

const data = loadData();
const rel = buildRelations(data);
const games = [...data.games].sort((a, b) => a.name.zh.localeCompare(b.name.zh, 'zh'));

const counts = (gid: string) => [
  (rel.entriesByGame.get(gid)?.length ?? 0) && `MOD${rel.entriesByGame.get(gid)!.length}`,
  (rel.toolsByGame.get(gid)?.length ?? 0) && `工具${rel.toolsByGame.get(gid)!.length}`,
  (rel.guidesByGame.get(gid)?.length ?? 0) && `教程${rel.guidesByGame.get(gid)!.length}`,
].filter(Boolean).join(' ');

const allGenres = [...new Set(games.flatMap((g) => g.genres ?? []))].sort();
const allPlatforms = [...new Set(games.flatMap((g) => (g.channels ?? []).map((c) => c.platform)))].sort();
---
<Base title="游戏库" description="全部已收录 PC 游戏档案" wide>
  <h1>游戏库 <span class="meta">已收录 <span data-count>{games.length}</span> 款</span></h1>

  <!-- 筛选条：即时搜索 + 下拉 + 排序 -->
  <div class="filterbar">
    <input type="search" class="fq" data-param="q" placeholder="页内搜索：游戏名 / 别名 / 关键词…" aria-label="页内搜索" />
    <details class="fmore" open>
      <summary>筛选 ▾</summary>
      <div class="fmore-body">
        <select data-param="genre" aria-label="类型筛选">
          <option value="">全部类型</option>
          {allGenres.map((g) => <option value={g}>{g}</option>)}
        </select>
        <select data-param="platform" aria-label="平台筛选">
          <option value="">全部平台</option>
          {allPlatforms.map((p) => <option value={p}>{p}</option>)}
        </select>
        <select data-param="sort" aria-label="排序" class="fsort">
          <option value="name">按名称</option>
          <option value="updated">最近更新</option>
        </select>
        <button type="button" class="fclear" data-clear hidden>清除全部</button>
      </div>
    </details>
  </div>
  <div class="chips" data-chips></div>

  <!-- 索引行 -->
  <div class="list" data-list>
    {games.map((g) => (
      <div data-row
        data-q={[g.name.zh, g.name.en, ...(g.aliases ?? []), ...(g.keywords ?? [])].join(' ').toLowerCase()}
        data-genres={(g.genres ?? []).join(',')}
        data-platforms={(g.channels ?? []).map((c) => c.platform).join(',')}
        data-updated={g.updatedAt}
      >
        <IndexRow href={withBase(`/games/${g.slug}/`)}>
          <span slot="main"><TextCover name={g.name.zh} /> {g.name.zh}{g.name.en && <span class="meta"> {g.name.en}</span>}</span>
          <span slot="sub">{(g.genres ?? []).slice(0, 2).map((t: string) => <span class="tag">{t}</span>)}</span>
          <span slot="meta">
            {counts(g.id) && <span class="mono">{counts(g.id)}</span>}
            {g.reviewStatus !== 'verified' && <StatusBadge kind="unverified" />}
          </span>
          <span slot="action">→</span>
        </IndexRow>
      </div>
    ))}
  </div>

  <div data-empty hidden>
    <EmptyState message="未找到符合条件的游戏" submitHref="/about/#feedback">
      <button type="button" class="fclear" data-clear>清除全部条件</button>
    </EmptyState>
  </div>
</Base>

<script>
  // 移动端默认收起筛选面板（桌面 HTML open 属性保持展开）
  if (matchMedia('(max-width: 639px)').matches)
    document.querySelector('.fmore')?.removeAttribute('open');
  import { initListFilter } from '../../client/list-filter.js';
  const rows = [...document.querySelectorAll('[data-row]')];
  const listEl = document.querySelector('[data-list]');
  initListFilter({
    filters: {
      q: (v, row) => row.dataset.q.includes(v.toLowerCase()),
      genre: (v, row) => row.dataset.genres.split(',').includes(v),
      platform: (v, row) => row.dataset.platforms.split(',').includes(v),
      sort: () => true,
    },
    emptyText: (s) => `未找到符合条件的游戏${s.q ? `「${s.q}」` : ''}`,
  });
  // 排序单独处理（DOM 重排）
  document.querySelector('[data-param="sort"]').addEventListener('change', (e) => {
    const v = e.target.value;
    const sorted = [...rows].sort((a, b) =>
      v === 'updated' ? b.dataset.updated.localeCompare(a.dataset.updated) : 0);
    if (v === 'updated') sorted.forEach((r) => listEl.appendChild(r));
  });
  // 清除按钮显隐
  const obs = () => {
    const any = document.querySelectorAll('.fchip').length > 0;
    document.querySelectorAll('[data-clear]').forEach((b) => (b.hidden = !any));
  };
  new MutationObserver(obs).observe(document.querySelector('[data-chips]'), { childList: true });
</script>

<style>
  h1 { display: flex; align-items: baseline; gap: var(--space-4); }
  .filterbar { display: flex; gap: var(--space-3); margin-bottom: var(--space-3); flex-wrap: wrap; }
  .fq {
    flex: 1; min-width: 200px; height: 40px;
    border: 1px solid var(--border-control); border-radius: var(--r-ctl);
    padding: 0 12px; font-size: var(--fs-sub); font-family: inherit;
    background: var(--bg-raised);
  }
  .fq:focus { border-color: var(--accent); outline: none; }
  select {
    height: 40px; padding: 0 10px;
    border: 1px solid var(--border-control); border-radius: var(--r-ctl);
    background: var(--bg-raised); font-size: var(--fs-sub); font-family: inherit;
    color: var(--text-primary);
  }
  .fclear {
    height: 40px; padding: 0 14px;
    border: 1px solid var(--border-control); border-radius: var(--r-ctl);
    background: var(--bg-raised); color: var(--accent);
    font-size: var(--fs-sub); cursor: pointer; font-family: inherit;
  }
  .chips { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-3); }
  .chips:empty { display: none; }
  .fchip {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 10px; border: 0; cursor: pointer;
    border-radius: var(--r-pill);
    background: var(--accent-soft); color: var(--text-secondary);
    font-size: var(--fs-badge); font-weight: 500; font-family: inherit;
  }
  .fchip:hover { color: var(--danger); }
  /* 筛选收纳：桌面展开内联（summary 隐藏），移动收成「筛选」按钮展开（05 §7.2/§8 修订#6） */
  .fmore { display: contents; }
  .fmore > summary { display: none; }
  .fmore-body { display: contents; }
  @media (max-width: 639px) {
    .filterbar { gap: var(--space-2); }
    .fmore { display: block; }
    .fmore > summary {
      display: flex; align-items: center; min-height: 44px; padding: 0 14px;
      border: 1px solid var(--border-control); border-radius: var(--r-ctl);
      background: var(--bg-raised); color: var(--accent); font-size: var(--fs-sub);
      cursor: pointer; list-style: none;
    }
    .fmore:not([open]) > summary { width: 100%; }
    .fmore-body { display: flex; flex-wrap: wrap; gap: var(--space-2); padding-top: var(--space-2); }
    select, .fclear { flex: 1; min-height: 44px; }
  }
</style>
