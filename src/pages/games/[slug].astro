---
import { withBase } from '../../lib/url.mjs';
// 游戏档案页 —— docs/05 §7.3 全模块；关联模块全部由 buildRelations 反查生成
// 可选模块无数据整块不渲染（模块收缩规则）
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import TextCover from '../../components/TextCover.astro';
import MetaDate from '../../components/MetaDate.astro';
import SourceLine from '../../components/SourceLine.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import AcquireButton from '../../components/AcquireButton.astro';
import ExtLink from '../../components/ExtLink.astro';
import WarningStrip from '../../components/WarningStrip.astro';
import IndexRow from '../../components/IndexRow.astro';
import JsonLd from '../../components/JsonLd.astro';
import { videoGameLd, breadcrumbLd } from '../../lib/jsonld.mjs';
import site from '../../../config/site.json';
import { loadData, buildRelations } from '../../lib/load.mjs';
import { computeLifecycle } from '../../lib/lifecycle.mjs';

export function getStaticPaths() {
  const data = loadData();
  return data.games.map((g) => ({ params: { slug: g.slug }, props: { game: g, data } }));
}

const { game: g, data } = Astro.props;
const rel = buildRelations(data);
const entries = rel.entriesByGame.get(g.id) ?? [];
const tools = rel.toolsByGame.get(g.id) ?? [];
const guides = rel.guidesByGame.get(g.id) ?? [];
const offers = rel.offersByGame.get(g.id) ?? [];
const sites = new Map(data.sites.map((s) => [s.id, s]));
const now = Date.now();
const activeOffer = offers.find((o) => ['active', 'upcoming', 'deadline_unknown'].includes(computeLifecycle(o, now, site.review.staleDays.offerTimed) ?? ''));
const relatedGames = (g.relatedGameIds ?? []).map((id) => data.games.find((x) => x.id === id)).filter(Boolean);
const hasQuick = (g.savePaths?.length ?? 0) + (g.configPaths?.length ?? 0) > 0;

const PLAT_LABEL: Record<string, string> = { steam: 'Steam', epic: 'Epic', gog: 'GOG', itch: 'itch.io', official: '官方', 'xbox-pc': 'Xbox PC', other: '其他' };
const CH_LABEL: Record<string, string> = { buy: '购买', free: '免费', trial: '试玩', subscription: '订阅' };
---
<Base title={g.name.zh} description={g.summary}>
  <JsonLd data={[videoGameLd(g, Astro.site.href), breadcrumbLd([['首页', '/'], ['游戏库', '/games/'], [g.name.zh, `/games/${g.slug}/`]], Astro.site.href)]} />
  <nav class="crumb meta" aria-label="面包屑"><a href={withBase('/')}>首页</a> / <a href={withBase('/games/')}>游戏库</a> / {g.name.zh}</nav>

  <!-- 档案头 -->
  <header class="gh">
    <TextCover name={g.name.zh} size="detail" />
    <div class="gh-main">
      <h1>{g.name.zh}</h1>
      <p class="gh-sub">
        {g.name.en && <span class="gh-en">{g.name.en}</span>}
        {(g.genres ?? []).map((t: string) => <span class="tag">{t}</span>)}
        {(g.os ?? []).map((o: string) => <span class="tag">{o}</span>)}
      </p>
      <p class="gh-sum">{g.summary}</p>
      <p class="gh-meta">
        <MetaDate checkedAt={g.checkedAt} staleDays={site.review.staleDays.entity} />
        {g.reviewStatus !== 'verified' && <StatusBadge kind="unverified" />}
        <a class="gh-fb" href={withBase('/about/#feedback')}>反馈</a>
      </p>
    </div>
  </header>

  <!-- 速查条 -->
  {hasQuick && (
    <div class="quick">
      {[...(g.savePaths ?? []).map((p: any) => ({ ...p, k: '存档' })), ...(g.configPaths ?? []).map((p: any) => ({ ...p, k: '配置' }))].map((p) => (
        <div class="quick-row">
          <span class="quick-k">{p.k}{p.os ? `·${p.os}` : ''}</span>
          <code class="mono">{p.path}</code>
          <button class="quick-copy" data-copy={p.path}>复制</button>
          {p.note && <span class="meta">{p.note}</span>}
        </div>
      ))}
    </div>
  )}

  <!-- 获取渠道 -->
  <Section title="获取渠道" id="channels">
    {activeOffer && (
      <WarningStrip>限免进行中{activeOffer.endDate ? `，截止 ${activeOffer.endDate}` : '，截止时间以官方页为准'}——<ExtLink href={activeOffer.url} label="前往活动页" /></WarningStrip>
    )}
    <div class="ch-table" role="table" aria-label="获取渠道">
      {g.channels.map((c: any) => {
        const dead = c.linkHealth === 'dead';
        return (
          <div class:list={['ch-row', { dead }]} role="row">
            <span class="ch-plat">{PLAT_LABEL[c.platform] ?? c.platform}</span>
            <span class="ch-type"><span class="tag">{CH_LABEL[c.type] ?? c.type}</span></span>
            <span class="ch-price sub">{c.priceNote ?? '—'}</span>
            <span class="ch-date meta mono">核验 {c.checkedAt}</span>
            <span class="ch-act"><AcquireButton href={c.url} health={c.linkHealth} /></span>
          </div>
        );
      })}
    </div>
  </Section>

  <!-- 常见问题 -->
  {(g.faqs?.length ?? 0) > 0 && (
    <Section title="常见问题" id="faq">
      {g.faqs.map((f: any) => {
        const guide = f.guideId && data.guides.find((x) => x.id === f.guideId);
        return (
          <details class="faq">
            <summary>{f.question}</summary>
            <div class="faq-body">
              {guide ? <a href={withBase(`/guides/${guide.slug}/`)}>查看教程：{guide.title} →</a> : <p>{f.answer}</p>}
            </div>
          </details>
        );
      })}
    </Section>
  )}

  <!-- MOD 与汉化（反查 entries） -->
  {entries.length > 0 && (
    <Section title="MOD 与汉化" id="mod">
      {entries.map((e) => {
        const s = sites.get(e.siteId);
        return (
          <IndexRow>
            <span slot="main"><ExtLink href={e.url} label={e.name} health={e.linkHealth} /></span>
            <span slot="sub">{s && <a href={withBase(`/resources/${s.slug}/`)}>{s.name}</a>}{e.note && <span class="meta"> {e.note}</span>}</span>
            <span slot="meta">{e.linkHealth !== 'ok' && <StatusBadge kind={e.linkHealth} />}</span>
          </IndexRow>
        );
      })}
    </Section>
  )}

  <!-- 工具（反查） -->
  {tools.length > 0 && (
    <Section title="工具与修改器" id="tools">
      {tools.map((t) => (
        <IndexRow href={withBase(`/tools/${t.slug}/`)}>
          <span slot="main">{t.name}</span>
          <span slot="sub"><span class="meta">{t.summary}</span></span>
          <span slot="meta"><ExtLink href={t.officialUrl} label="官网" health={t.linkHealth} /></span>
          <span slot="action">详情→</span>
        </IndexRow>
      ))}
    </Section>
  )}

  <!-- 相关教程 + 相关游戏 -->
  {(guides.length > 0 || relatedGames.length > 0) && (
    <div class="duo">
      {guides.length > 0 && (
        <Section title="相关教程" id="guides">
          {guides.map((x) => <p class="rel"><a href={withBase(`/guides/${x.slug}/`)}>{x.title}</a></p>)}
        </Section>
      )}
      {relatedGames.length > 0 && (
        <Section title="相关游戏" id="related">
          {relatedGames.map((x) => <p class="rel"><a href={withBase(`/games/${x.slug}/`)}>{x.name.zh}</a></p>)}
        </Section>
      )}
    </div>
  )}

  <footer class="gfoot meta">
    <MetaDate checkedAt={g.checkedAt} staleDays={site.review.staleDays.entity} /> ·
    信息有误或已失效？<a href={withBase('/about/#feedback')}>告诉我们</a>
    {g.sources?.length > 0 && <SourceLine sources={g.sources} />}
  </footer>

  <!-- 页内目录（≥1200px 浮出右侧 200px，不占内容宽） -->
  <nav class="ptoc" aria-label="页内目录">
    <a href="#channels">获取渠道</a>
    {g.faqs?.length > 0 && <a href="#faq">常见问题</a>}
    {entries.length > 0 && <a href="#mod">MOD 与汉化</a>}
    {tools.length > 0 && <a href="#tools">工具</a>}
    {guides.length > 0 && <a href="#guides">相关教程</a>}
  </nav>
</Base>

<script>
  for (const b of document.querySelectorAll('[data-copy]'))
    b.addEventListener('click', async () => {
      await navigator.clipboard.writeText(b.dataset.copy).catch(() => {});
      b.textContent = '已复制';
      setTimeout(() => (b.textContent = '复制'), 1500);
    });
</script>

<style>
  .crumb { margin-bottom: var(--space-5); }
  .gh { display: flex; gap: var(--space-5); margin-bottom: var(--space-6); }
  .gh-main { flex: 1; min-width: 0; }
  .gh-sub { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; margin-bottom: var(--space-2); }
  .gh-en { color: var(--text-tertiary); font-size: var(--fs-sub); }
  .gh-sum { color: var(--text-secondary); margin-bottom: var(--space-2); }
  .gh-meta { display: flex; align-items: center; gap: var(--space-3); }
  .gh-fb { font-size: var(--fs-meta); }

  .quick { background: var(--bg-sunken); border-radius: var(--r-ctl); padding: var(--space-3) var(--space-4); }
  .quick-row { display: flex; align-items: center; gap: var(--space-3); padding: 4px 0; font-size: var(--fs-meta); overflow-x: auto; }
  .quick-k { color: var(--text-secondary); white-space: nowrap; }
  .quick-row code { word-break: break-all; }
  .quick-copy {
    flex-shrink: 0; border: 1px solid var(--border-control); border-radius: var(--r-ctl);
    background: var(--bg-raised); color: var(--accent); font-size: var(--fs-badge);
    padding: 2px 8px; cursor: pointer; font-family: inherit;
  }

  .ch-table { margin-top: var(--space-4); }
  .ch-row { display: grid; grid-template-columns: 1fr auto 1fr auto auto; align-items: center; gap: var(--space-3); padding: var(--space-3) 0; border-bottom: 1px solid var(--border); }
  .ch-plat { font-weight: 500; }
  .ch-row.dead { opacity: .7; }
  .ch-row.dead .ch-plat { text-decoration: line-through; color: var(--text-tertiary); }
  @media (max-width: 639px) {
    .ch-row { grid-template-columns: 1fr auto; grid-template-areas: 'plat type' 'price date' 'act act'; }
    .ch-act { grid-area: act; display: flex; }
  }

  .faq { border-bottom: 1px solid var(--border); }
  .faq summary { padding: var(--space-3) 0; cursor: pointer; font-size: var(--fs-sub); list-style: none; }
  .faq summary::before { content: '▸'; color: var(--text-tertiary); margin-right: 8px; }
  .faq[open] summary::before { content: '▾'; }
  .faq-body { padding: 0 0 var(--space-4) 22px; font-size: var(--fs-sub); }

  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-7); }
  @media (max-width: 639px) { .duo { grid-template-columns: 1fr; gap: 0; } }
  .rel { margin: 0 0 var(--space-2); font-size: var(--fs-sub); }
  .gfoot { margin-top: var(--space-7); padding-top: var(--space-4); border-top: 1px solid var(--border); display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center; }
  .ptoc { display: none; }
  @media (min-width: 1200px) {
    .ptoc {
      display: flex; flex-direction: column; gap: var(--space-2);
      position: fixed; top: calc(var(--nav-h) + var(--space-7)); right: max(var(--space-5), calc((100vw - var(--w-doc)) / 2 - 220px));
      width: 200px; font-size: var(--fs-meta);
    }
    .ptoc a { color: var(--text-tertiary); }
    .ptoc a:hover { color: var(--accent); }
  }
</style>
