---
// /free/ —— docs/05 §7.4：默认五分区视图；任一筛选激活→统一结果列表（B 方案定案）
// 生命周期=构建期权威计算；浏览器端用同一 lifecycle.mjs 仅对已结束项补充置灰（docs/06 §9）
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import OfferRow from '../components/OfferRow.astro';
import ExtLink from '../components/ExtLink.astro';
import EmptyState from '../components/EmptyState.astro';
import site from '../../config/site.json';
import { loadData } from '../lib/load.mjs';
import { computeLifecycle } from '../lib/lifecycle.mjs';

const data = loadData();
const now = Date.now();
const sd = site.review.staleDays.offerTimed;
const lcOf = (o: any) => computeLifecycle(o, now, sd);

const TYPES = [
  { key: 'limited', label: '限时领取', desc: '在截止前领取即可永久入库' },
  { key: 'permanent', label: '永久免费', desc: '本身就是免费的 F2P/免费游戏' },
  { key: 'trial', label: '免费试玩', desc: '官方 Demo / 试玩版' },
  { key: 'weekend', label: '免费周末', desc: '限时畅玩，非永久入库' },
  { key: 'opensource', label: '开源', desc: '开源免费游戏' },
];
const active = data.offers.filter((o) => lcOf(o) !== 'ended');
const ended = data.offers.filter((o) => lcOf(o) === 'ended');
const byType = (k: string) => active.filter((o) => o.type === k);
const allPlatforms = [...new Set(data.offers.map((o) => o.platform))].sort();
const buildDate = new Date(now).toISOString().slice(0, 10);
---
<Base title="免费游戏" description="永久免费、限时领取、免费试玩、免费周末、开源游戏索引" wide>
  <h1>免费游戏 <span class="meta">本页最近构建 <time class="mono">{buildDate}</time></span></h1>
  <p class="sub">五类免费：限时领取 · 永久免费 · 免费试玩 · 免费周末 · 开源 —— 只收录官方活动页</p>

  <div class="filterbar">
    <input type="search" class="fq" data-param="q" placeholder="关键词…" aria-label="关键词筛选" />
    <select data-param="platform" aria-label="平台筛选">
      <option value="">全部平台</option>
      {allPlatforms.map((p) => <option value={p}>{p}</option>)}
    </select>
    <details class="ftype">
      <summary>类型 ▾</summary>
      <div class="ftype-panel">
        {TYPES.map((t) => <label><input type="checkbox" data-param="type" value={t.key} /> {t.label}</label>)}
      </div>
    </details>
    <button type="button" class="fclear" data-clear hidden>清除全部</button>
  </div>
  <div class="chips" data-chips></div>

  <!-- 分区视图（默认，无筛选时显示） -->
  <div data-sections>
    {TYPES.map((t) => byType(t.key).length > 0 && (
      <Section title={t.label} id={t.key}>
        <p class="sub sect-desc">{t.desc}</p>
        {byType(t.key).map((o) => (
          <div data-row data-q={o.gameTitle.toLowerCase()} data-platform={o.platform} data-type={o.type}>
            <OfferRow offer={o} now={now} />
          </div>
        ))}
      </Section>
    ))}
  </div>

  <!-- 统一筛选视图（有参数时由脚本切换显示） -->
  <div data-flat hidden></div>

  <div data-empty hidden>
    <EmptyState message="没有符合条件的免费活动" submitHref="/about/#feedback">
      <button type="button" class="fclear" data-clear>清除全部条件</button>
    </EmptyState>
  </div>

  <!-- 实时追踪入口 -->
  <Section title="实时追踪">
    <p class="sub">以下为第三方免费情报源，站内信息以核验日期为准：</p>
    <p class="track">
      <ExtLink href="https://isthereanydeal.com/" label="IsThereAnyDeal" site="ITAD" />
      <ExtLink href="https://steamdb.info/" label="SteamDB" site="SteamDB" />
      <ExtLink href="https://store.epicgames.com/zh-CN/free-games" label="Epic 每周免费" site="Epic" />
    </p>
  </Section>

  <!-- 已结束归档 -->
  {ended.length > 0 && (
    <details class="ended">
      <summary>已结束（{ended.length}）</summary>
      {ended.map((o) => <OfferRow offer={o} now={now} />)}
    </details>
  )}
</Base>

<script>
  import { initListFilter } from '../client/list-filter.js';
  const sectionsEl = document.querySelector('[data-sections]');
  const flatEl = document.querySelector('[data-flat]');
  // 统一筛选视图：把分区里的 data-row 克隆进 flat 容器，筛选激活时切换显示
  const sectionRows = [...document.querySelectorAll('[data-sections] [data-row]')];
  const anyFilter = () =>
    ['q', 'platform', 'type'].some((p) => {
      const el = document.querySelector(`[data-param="${p}"]`);
      return el?.type === 'checkbox'
        ? [...document.querySelectorAll(`[data-param="${p}"]`)].some((c) => c.checked)
        : el?.value;
    });
  initListFilter({
    multi: ['type'],
    filters: {
      q: (v, row) => row.dataset.q.includes(v.toLowerCase()),
      platform: (v, row) => row.dataset.platform === v,
      type: (v, row) => v.includes(row.dataset.type),
    },
    labels: { type: { limited: '限时领取', permanent: '永久免费', trial: '免费试玩', weekend: '免费周末', opensource: '开源' } },
    emptyText: (s) => `没有符合条件的免费活动${s.q ? `「${s.q}」` : ''}`,
  });
  // 视图切换：任一筛选激活 → flat 统一列表；否则分区视图
  const sync = () => {
    const filtering = document.querySelectorAll('.fchip').length > 0;
    if (filtering && flatEl.children.length === 0)
      for (const r of sectionRows) flatEl.appendChild(r);
    if (!filtering && flatEl.children.length > 0) {
      for (const r of [...flatEl.children]) {
        const sec = sectionsEl.querySelector(`#${r.dataset.type}`).parentElement;
        sec.appendChild(r);
      }
    }
    sectionsEl.hidden = filtering;
    flatEl.hidden = !filtering;
  };
  new MutationObserver(sync).observe(document.querySelector('[data-chips]'), { childList: true });
  sync();
  // 清除按钮显隐
  const obs = () => document.querySelectorAll('[data-clear]').forEach((b) => (b.hidden = document.querySelectorAll('.fchip').length === 0));
  new MutationObserver(obs).observe(document.querySelector('[data-chips]'), { childList: true });
</script>

<style>
  h1 { display: flex; align-items: baseline; gap: var(--space-4); flex-wrap: wrap; }
  .filterbar { display: flex; gap: var(--space-3); margin: var(--space-4) 0 var(--space-3); flex-wrap: wrap; }
  .fq { flex: 1; min-width: 160px; height: 40px; border: 1px solid var(--border-control); border-radius: var(--r-ctl); padding: 0 12px; font-size: var(--fs-sub); font-family: inherit; background: var(--bg-raised); }
  .fq:focus { border-color: var(--accent); outline: none; }
  select { height: 40px; padding: 0 10px; border: 1px solid var(--border-control); border-radius: var(--r-ctl); background: var(--bg-raised); font-size: var(--fs-sub); font-family: inherit; color: var(--text-primary); }
  .ftype { position: relative; }
  .ftype summary { height: 40px; display: flex; align-items: center; padding: 0 14px; border: 1px solid var(--border-control); border-radius: var(--r-ctl); background: var(--bg-raised); font-size: var(--fs-sub); cursor: pointer; list-style: none; }
  .ftype[open] summary { border-color: var(--accent); }
  .ftype-panel { position: absolute; top: 44px; left: 0; z-index: 20; min-width: 160px; background: var(--bg-raised); border-radius: var(--r-ctl); box-shadow: var(--shadow-overlay); padding: var(--space-2); display: flex; flex-direction: column; }
  .ftype-panel label { display: flex; align-items: center; gap: 8px; min-height: 36px; padding: 0 var(--space-2); font-size: var(--fs-sub); cursor: pointer; }
  .fclear { height: 40px; padding: 0 14px; border: 1px solid var(--border-control); border-radius: var(--r-ctl); background: var(--bg-raised); color: var(--accent); font-size: var(--fs-sub); cursor: pointer; font-family: inherit; }
  .chips { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-3); }
  .chips:empty { display: none; }
  .fchip { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border: 0; cursor: pointer; border-radius: var(--r-pill); background: var(--accent-soft); color: var(--text-secondary); font-size: var(--fs-badge); font-weight: 500; font-family: inherit; }
  .fchip:hover { color: var(--danger); }
  .sect-desc { margin-bottom: var(--space-3); }
  .track { display: flex; gap: var(--space-5); flex-wrap: wrap; }
  .ended { margin-top: var(--space-7); border-top: 1px solid var(--border); padding-top: var(--space-4); }
  .ended summary { cursor: pointer; color: var(--text-tertiary); font-size: var(--fs-sub); margin-bottom: var(--space-3); list-style: none; }
  .ended summary::before { content: '▸ '; }
  .ended[open] summary::before { content: '▾ '; }
  @media (max-width: 639px) {
    .filterbar { gap: var(--space-2); }
    select, .ftype, .fclear { flex: 1; }
    .ftype summary, select, .fclear { min-height: 44px; }
  }
</style>
