---
import { withBase } from '../../lib/url.mjs';
// 教程详情 —— docs/05 §7.8：标题+徽标+适用范围 → 问题描述( sunken 块+报错 mono ) → 编号步骤 → 恢复/来源/相关
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import StepBlock from '../../components/StepBlock.astro';
import MetaDate from '../../components/MetaDate.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import SourceLine from '../../components/SourceLine.astro';
import IndexRow from '../../components/IndexRow.astro';
import JsonLd from '../../components/JsonLd.astro';
import { howToLd, breadcrumbLd } from '../../lib/jsonld.mjs';
import site from '../../../config/site.json';
import { loadData } from '../../lib/load.mjs';
import { zh } from '../../lib/labels.mjs';

export function getStaticPaths() {
  const data = loadData();
  return data.guides.map((g) => ({ params: { slug: g.slug }, props: { guide: g, data } }));
}
const { guide: g, data } = Astro.props;
const games = (g.games ?? []).map((id) => data.games.find((x) => x.id === id)).filter(Boolean);
const tools = (g.tools ?? []).map((id) => data.tools.find((x) => x.id === id)).filter(Boolean);
const relGuides = (g.relatedGuides ?? []).map((id) => data.guides.find((x) => x.id === id)).filter(Boolean);

// 同名 .md 长正文（可选模块，缺失隐藏）
const mdMods = import.meta.glob('../../data/guides/*.md', { eager: true });
const md = mdMods[`../../data/guides/${g.slug}.md`] as any;
const MdContent = md?.Content;
---
<Base title={g.title} description={g.problem?.description ?? g.title}>
  <JsonLd data={[howToLd(g, Astro.site.href), breadcrumbLd([['首页', '/'], ['教程', '/guides/'], [g.title, `/guides/${g.slug}/`]], Astro.site.href)]} />
  <nav class="crumb meta"><a href={withBase('/')}>首页</a> / <a href={withBase('/guides/')}>教程</a> / {g.title}</nav>
  <header class="gd">
    <h1>{g.title}</h1>
    <p class="gd-sub">
      <span class="tag">{zh('guideKind', g.kind)}</span>
      <span class="tag">{zh('guideCategory', g.category)}</span>
      {games.map((x) => <a class="gchip" href={withBase(`/games/${x.slug}/`)}>{x.name.zh}</a>)}
      {(g.os ?? []).map((o: string) => <span class="tag">{zh('os', o)}</span>)}
    </p>
    <p class="gd-meta"><MetaDate checkedAt={g.checkedAt} staleDays={site.review.staleDays.guide} />{g.reviewStatus !== 'verified' && <StatusBadge kind="unverified" />}</p>
  </header>

  {g.problem && (
    <div class="prob">
      {g.problem.description && <p>{g.problem.description}</p>}
      {g.problem.errorText && <p class="prob-err mono">{g.problem.errorText}</p>}
      {g.problem.conditions && <p class="meta">适用：{g.problem.conditions}</p>}
    </div>
  )}
  {g.prerequisites?.length > 0 && <p class="sub">前置：{g.prerequisites.join('；')}</p>}

  <Section title="排查步骤" id="steps">
    {g.steps.map((s: any, i: number) => <StepBlock n={i + 1} step={s} />)}
  </Section>

  {MdContent && <Section title="补充说明" id="more"><div class="md"><MdContent /></div></Section>}

  {g.recovery?.length > 0 && (
    <Section title="恢复方法" id="recovery">
      <ul class="recv">{g.recovery.map((r: string) => <li>{r}</li>)}</ul>
    </Section>
  )}

  {tools.length > 0 && (
    <Section title="相关工具" id="tools">
      {tools.map((t) => <IndexRow href={withBase(`/tools/${t.slug}/`)}><span slot="main">{t.name}</span><span slot="sub"><span class="meta">{t.summary}</span></span><span slot="action">→</span></IndexRow>)}
    </Section>
  )}
  {relGuides.length > 0 && (
    <Section title="相关教程" id="related">
      {relGuides.map((x) => <p class="rel"><a href={withBase(`/guides/${x.slug}/`)}>{x.title}</a></p>)}
    </Section>
  )}

  {g.sources?.length > 0 && <SourceLine sources={g.sources} />}
  <footer class="gfoot meta">
    <MetaDate checkedAt={g.checkedAt} staleDays={site.review.staleDays.guide} /> ·
    <a href={withBase('/about/#feedback')}>反馈</a>
  </footer>
  <nav class="ptoc" aria-label="页内目录">
    <a href="#steps">排查步骤</a>
    {MdContent && <a href="#more">补充说明</a>}
    {g.recovery?.length > 0 && <a href="#recovery">恢复方法</a>}
    {tools.length > 0 && <a href="#tools">相关工具</a>}
  </nav>
</Base>

<style>
  .crumb { margin-bottom: var(--space-5); }
  .gd { margin-bottom: var(--space-5); }
  .gd-sub { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; margin-bottom: var(--space-2); }
  .gchip { padding: 2px 10px; border: 1px solid var(--border-control); border-radius: var(--r-pill); font-size: var(--fs-meta); color: var(--accent); text-decoration: none !important; }
  .gd-meta { display: flex; gap: var(--space-3); }
  .prob { background: var(--bg-sunken); border-radius: var(--r-ctl); padding: var(--space-4); margin-bottom: var(--space-4); }
  .prob p { margin: 0 0 var(--space-2); font-size: var(--fs-sub); }
  .prob-err { word-break: break-all; color: var(--danger); }
  .recv { margin: 0; padding-left: 1.4em; font-size: var(--fs-sub); }
  .rel { margin: 0 0 var(--space-2); font-size: var(--fs-sub); }
  .md { font-size: var(--fs-sub); }
  .gfoot { margin-top: var(--space-7); padding-top: var(--space-4); border-top: 1px solid var(--border); display: flex; gap: var(--space-3); align-items: center; }
  .ptoc { display: none; }
  @media (min-width: 1200px) {
    .ptoc { display: flex; flex-direction: column; gap: var(--space-2); position: fixed; top: calc(var(--nav-h) + var(--space-7)); right: max(var(--space-5), calc((100vw - var(--w-doc)) / 2 - 220px)); width: 200px; font-size: var(--fs-meta); }
    .ptoc a { color: var(--text-tertiary); }
    .ptoc a:hover { color: var(--accent); }
  }
</style>
