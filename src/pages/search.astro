---
import { withBase } from '../lib/url.mjs';
// /search/ —— noindex 页面（docs/05 §7.9）：框回填 → 分类 tab → 分组结果
// 三态不混用：空引导态 / 无结果态 / 索引加载失败态
import Base from '../layouts/Base.astro';
import SearchBar from '../components/SearchBar.astro';
---
<Base title="搜索" description="站内搜索" noindex>
  <h1>搜索</h1>
  <div class="sbig"><SearchBar variant="global" /></div>

  <div class="stabs" data-tabs hidden>
    <button class="stab cur" data-t="">全部 <span data-n="all"></span></button>
    <button class="stab" data-t="game">游戏 <span data-n="game"></span></button>
    <button class="stab" data-t="site">资源站 <span data-n="site"></span></button>
    <button class="stab" data-t="tool">工具 <span data-n="tool"></span></button>
    <button class="stab" data-t="guide">教程 <span data-n="guide"></span></button>
  </div>

  <!-- 空引导态 -->
  <div class="sstate" data-state="idle" hidden>
    <p class="sub">输入游戏名、报错文本、工具名试试——也可以先去：</p>
    <p class="hot"><a href={withBase('/games/')}>浏览游戏库</a> · <a href={withBase('/free/')}>看免费活动</a> · <a href={withBase('/guides/')}>看教程</a></p>
  </div>

  <!-- 无结果态 -->
  <div class="sstate" data-state="none" hidden>
    <p>没有找到「<span data-nq></span>」相关的内容。</p>
    <p class="sub">换个关键词，或<a href={withBase('/about/#feedback')}>提交收录请求</a>。</p>
  </div>

  <!-- 索引加载失败态 -->
  <div class="sstate" data-state="error" hidden>
    <p>搜索索引加载失败。</p>
    <p class="sub"><button class="stab" data-retry>重试</button> 或直接<a href={withBase('/games/')}>走索引页</a>。</p>
  </div>

  <div class="sres" data-results></div>
</Base>

<script>
  const $ = (s) => document.querySelector(s);
  const resEl = $('[data-results]');
  const states = Object.fromEntries([...document.querySelectorAll('.sstate')].map((e) => [e.dataset.state, e]));
  let INDEX = null;

  const setState = (name) => {
    for (const [k, el] of Object.entries(states)) el.hidden = k !== name;
    resEl.hidden = name !== null;
  };

  async function loadIndex() {
    try {
      const r = await fetch(import.meta.env.BASE_URL + 'search-index.json');
      if (!r.ok) throw new Error(String(r.status));
      INDEX = await r.json();
      return true;
    } catch { return false; }
  }

  function esc(s) { return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])); }
  const hit = (item, q) => {
    const hay = [item.title, item.sub, item.summary, ...(item.keywords ?? [])].join(' ').toLowerCase();
    return q.toLowerCase().split(/\s+/).every((w) => hay.includes(w));
  };
  const hl = (text, q) => esc(text ?? '').replace(
    new RegExp(`(${q.trim().split(/\s+/).map((w) => w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'gi'), '<mark>$1</mark>');

  let curTab = '';
  function render(q) {
    const hits = INDEX.items.filter((i) => hit(i, q));
    const groups = ['game', 'site', 'tool', 'guide'].map((t) => ({
      t, list: hits.filter((i) => i.type === t),
    }));
    const label = { game: '游戏', site: '资源站', tool: '工具', guide: '教程' };
    $('[data-n="all"]').textContent = hits.length;
    for (const g of groups) $(`[data-n="${g.t}"]`).textContent = g.list.length;
    $('[data-tabs]').hidden = false;

    const shown = curTab ? groups.filter((g) => g.t === curTab) : groups;
    resEl.innerHTML = shown.filter((g) => g.list.length).map((g) => `
      <section class="sgroup"><h2>${label[g.t]}</h2>
        ${g.list.map((i) => `
          <a class="sitem" href="${import.meta.env.BASE_URL.replace(/\/$/,'')}${i.url}">
            <span class="stag tag">${i.typeLabel}</span>
            <span class="stitle">${hl(i.title, q)}${i.sub ? ` <span class="meta">${hl(i.sub, q)}</span>` : ''}</span>
            <span class="ssum meta">${hl((i.summary ?? '').slice(0, 80), q)}</span>
          </a>`).join('')}
      </section>`).join('');
    setState(hits.length ? null : 'none');
    $('[data-nq]').textContent = q;
  }

  async function go() {
    const q = new URL(location.href).searchParams.get('q')?.trim() ?? '';
    if (!q) return setState('idle');
    if (!INDEX && !(await loadIndex())) return setState('error');
    render(q);
  }
  document.querySelectorAll('.stab[data-t]').forEach((t) =>
    t.addEventListener('click', () => {
      document.querySelectorAll('.stab').forEach((x) => x.classList.remove('cur'));
      t.classList.add('cur'); curTab = t.dataset.t; go();
    }));
  $('[data-retry]')?.addEventListener('click', async () => { INDEX = null; await go(); });
  // 表单提交后 URL 变化（同页 GET）：监听 popstate 与 submit 均可；直接监听 input 事件做即时搜
  const input = document.querySelector('.searchbar input');
  input.value = new URL(location.href).searchParams.get('q') ?? '';
  input.addEventListener('input', () => {
    const u = new URL(location.href);
    input.value ? u.searchParams.set('q', input.value) : u.searchParams.delete('q');
    history.replaceState(null, '', u);
    go();
  });
  go();
</script>

<style>
  .sbig { max-width: 560px; margin-bottom: var(--space-5); }
  .stabs { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-5); }
  .stab { min-height: 36px; padding: 0 14px; border: 1px solid var(--border-control); border-radius: var(--r-pill); background: var(--bg-raised); color: var(--text-secondary); font-size: var(--fs-sub); cursor: pointer; font-family: inherit; }
  .stab.cur { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
  .sstate { padding: var(--space-7) 0; }
  .hot { font-size: var(--fs-sub); }
  .sgroup { margin-bottom: var(--space-5); }
  .sgroup h2 { font-size: var(--fs-h3); border-bottom: 1px solid var(--border); padding-bottom: var(--space-2); margin-bottom: var(--space-3); }
  .sitem { display: block; padding: var(--space-3) var(--space-2); border-bottom: 1px solid var(--border); color: var(--text-primary); text-decoration: none !important; }
  .sitem:hover { background: var(--bg-sunken); }
  .stitle { font-weight: 500; }
  .ssum { display: block; margin-top: 2px; }
  .stag { margin-right: 8px; }
  .sitem :global(mark) { background: var(--accent-soft); color: var(--accent); padding: 0 1px; border-radius: 2px; }
</style>
