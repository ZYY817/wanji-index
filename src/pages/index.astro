---
import { withBase } from '../lib/url.mjs';
// 首页 —— docs/05 §7.1 结构：导航 → Hero(搜索) → 分流 → 精选档案 → 免费快报 → 工具+更新 → 页脚
// 模块缺数据整块隐藏；display 标题与 Hero 肌理按 05 修订 #10 授权执行
import Base from '../layouts/Base.astro';
import site from '../../config/site.json';
import Section from '../components/Section.astro';
import SearchBar from '../components/SearchBar.astro';
import IndexRow from '../components/IndexRow.astro';
import TextCover from '../components/TextCover.astro';
import StatusBadge from '../components/StatusBadge.astro';
import OfferRow from '../components/OfferRow.astro';
import JsonLd from '../components/JsonLd.astro';
import { webSiteLd } from '../lib/jsonld.mjs';
import { loadData, buildRelations } from '../lib/load.mjs';

const data = loadData();
const rel = buildRelations(data);
const now = Date.now();
const sd = site.review.staleDays;

const counts = (gid: string) => [
  (rel.entriesByGame.get(gid)?.length ?? 0) && `MOD${rel.entriesByGame.get(gid)!.length}`,
  (rel.toolsByGame.get(gid)?.length ?? 0) && `工具${rel.toolsByGame.get(gid)!.length}`,
  (rel.guidesByGame.get(gid)?.length ?? 0) && `教程${rel.guidesByGame.get(gid)!.length}`,
].filter(Boolean).join(' ');

const ENTRY = [
  { href: withBase('/games/'), title: '找游戏', desc: '浏览全部游戏档案' },
  { href: withBase('/free/'), title: '找免费', desc: '限免 / 试玩 / 开源' },
  { href: withBase('/resources/?cat=mod'), title: '找 MOD/汉化', desc: '资源站 · MOD 社区' },
  { href: withBase('/tools/'), title: '找工具', desc: '存档 / MOD 管理 / 修复' },
  { href: withBase('/guides/'), title: '游戏出问题', desc: '报错排查与教程' },
];

const offers = [...data.offers].sort((a, b) => b.checkedAt.localeCompare(a.checkedAt)).slice(0, 5);
const games = data.games.slice(0, 8);
const tools = data.tools.slice(0, 6);
const updated = [...data.games, ...data.sites, ...data.tools, ...data.guides]
  .sort((a, b) => b.updatedAt.localeCompare(a.updatedAt)).slice(0, 7);
---
<Base title={site.name} description="中文 PC 游戏资源与工具索引：游戏档案、免费情报、MOD/汉化资源站、工具与报错排查。" wide>
  <JsonLd data={webSiteLd(site, Astro.site.href)} />

  <!-- Hero：搜索即功能 -->
  <section class="hero">
    <div class="hero-inner">
      <h1 class="hero-title">{site.name}</h1>
      <p class="hero-tag">找游戏 · 找资源 · 解决问题 —— 只指向可信来源的中文 PC 游戏索引</p>
      <div class="hero-search"><SearchBar variant="global" /></div>
    </div>
  </section>

  <!-- 分流入口 -->
  <nav class="entry-grid" aria-label="从这里开始">
    <p class="entry-label">从这里开始</p>
    <div class="entry-cols">
      {ENTRY.map((e, i) => (
        <a class:list={['entry-row', { span: i === 4 }]} href={e.href}>
          <span class="entry-title">{e.title}</span>
          <span class="entry-desc">{e.desc}</span>
          <span class="entry-arr" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </nav>

  <!-- 精选游戏档案 -->
  {games.length > 0 && (
    <Section title="游戏档案">
      {games.map((g) => (
        <IndexRow href={withBase(`/games/${g.slug}/`)}>
          <span slot="main"><TextCover name={g.name.zh} /> {g.name.zh}{g.name.en && <span class="meta"> {g.name.en}</span>}</span>
          <span slot="sub">{(g.genres ?? []).slice(0, 2).map((t: string) => <span class="tag">{t}</span>)}</span>
          <span slot="meta">
            {counts(g.id) && <span class="mono">{counts(g.id)}</span>}
            {g.reviewStatus !== 'verified' && <StatusBadge kind="unverified" />}
          </span>
          <span slot="action">→</span>
        </IndexRow>
      ))}
      <p class="more"><a href={withBase('/games/')}>浏览全部 {data.games.length} 款 →</a></p>
    </Section>
  )}

  <!-- 免费快报 -->
  {offers.length > 0 && (
    <Section title="免费游戏快报">
      {offers.map((o) => <OfferRow offer={o} now={now} />)}
      <p class="more"><a href={withBase('/free/')}>查看全部免费内容 →</a></p>
    </Section>
  )}

  <!-- 热门工具 + 最近更新 双栏 -->
  {(tools.length > 0 || updated.length > 0) && (
    <div class="duo">
      {tools.length > 0 && (
        <Section title="热门工具">
          {tools.map((t) => (
            <IndexRow href={withBase(`/tools/${t.slug}/`)}>
              <span slot="main">{t.name}</span>
              <span slot="sub"><span class="meta">{t.summary}</span></span>
              <span slot="meta">{t.supportedGames?.length ? <span class="mono">适用{t.supportedGames.length}款</span> : <span class="meta">通用</span>}</span>
              <span slot="action">→</span>
            </IndexRow>
          ))}
        </Section>
      )}
      {updated.length > 0 && (
        <Section title="最近更新">
          {updated.map((r) => (
            <IndexRow>
              <span slot="main">{r.name?.zh ?? r.name ?? r.title}</span>
              <span slot="meta"><span class="mono">{r.updatedAt}</span></span>
            </IndexRow>
          ))}
        </Section>
      )}
    </div>
  )}
</Base>

<style>
  /* ── Hero：display 档标题 + 极轻档案肌理（05 修订 #10-11）── */
  .hero {
    margin: calc(-1 * var(--space-7)) calc(-1 * var(--space-5)) var(--space-7);
    padding: var(--space-8) var(--space-5) var(--space-7);
    background:
      repeating-linear-gradient(180deg, transparent 0 27px, rgba(29,33,41,.028) 27px 28px),
      radial-gradient(ellipse 70% 60% at 50% 0%, rgba(47,91,215,.06), transparent 70%);
    text-align: center;
  }
  .hero-inner { max-width: 640px; margin: 0 auto; }
  .hero-title {
    font-size: clamp(30px, 4vw, 36px);
    font-weight: 700; letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero-tag { color: var(--text-secondary); font-size: 15px; margin-bottom: var(--space-5); }
  .hero-search { max-width: 520px; margin: 0 auto; }
  @media (max-width: 639px) {
    .hero { margin: calc(-1 * var(--space-7)) calc(-1 * var(--space-4)) var(--space-6); padding: var(--space-6) var(--space-4); }
  }

  /* ── 分流入口（文字列表式，禁卡片墙）── */
  .entry-grid { margin-bottom: var(--space-7); }
  .entry-label { font-size: var(--fs-meta); color: var(--text-tertiary); margin-bottom: var(--space-2); }
  .entry-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--space-6); }
  .entry-row {
    display: flex; align-items: baseline; gap: var(--space-3);
    padding: var(--space-3) var(--space-2);
    border-bottom: 1px solid var(--border);
    color: var(--text-primary); text-decoration: none !important;
    transition: background 120ms var(--ease);
  }
  .entry-row:hover { background: var(--bg-sunken); }
  .entry-row.span { grid-column: 1 / -1; }
  .entry-title { font-weight: 500; font-size: 15px; white-space: nowrap; }
  .entry-desc { color: var(--text-tertiary); font-size: var(--fs-meta); flex: 1; }
  .entry-arr { color: var(--text-tertiary); transition: transform 120ms var(--ease), color 120ms var(--ease); }
  .entry-row:hover .entry-arr { color: var(--accent); transform: translateX(3px); }
  @media (max-width: 639px) { .entry-cols { grid-template-columns: 1fr; } }

  /* ── 双栏（工具/更新），移动堆叠 ── */
  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-7); }
  @media (max-width: 639px) { .duo { grid-template-columns: 1fr; gap: 0; } }

  .more { font-size: var(--fs-sub); margin: var(--space-3) 0 0; }
</style>
