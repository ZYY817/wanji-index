---
// 索引行 —— 全站列表的基本单元（docs/05 D2/§8）
// H64–72px、行间 1px 装饰线、hover 浅底、移动端两行式重排
// 用法：<IndexRow href="..."><span slot="main">…</span><span slot="meta">…</span><span slot="action">…</span></IndexRow>
// href 存在时整行可点（左部主区为链接）；操作区放独立链接/按钮
interface Props { href?: string }
const { href } = Astro.props;
---
<div class="irow">
  <div class="irow-main">
    {href ? <a class="irow-link" href={href}><slot name="main" /></a> : <slot name="main" />}
    <slot name="sub" />
  </div>
  <div class="irow-side">
    <slot name="meta" />
    <span class="irow-action"><slot name="action" /></span>
  </div>
</div>
<style>
  .irow {
    display: flex; align-items: center; gap: var(--space-4);
    min-height: 64px; max-height: none;
    padding: var(--space-3) var(--space-2);
    border-bottom: 1px solid var(--border);
    transition: background 120ms var(--ease);
  }
  .irow:hover { background: var(--bg-sunken); }
  .irow-main { flex: 1; min-width: 0; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .irow-link { color: var(--text-primary); font-weight: 500; font-size: 15px; }
  .irow-link:hover { color: var(--accent); text-decoration: none; }
  .irow-side { display: flex; align-items: center; gap: var(--space-3); flex-shrink: 0; font-size: var(--fs-meta); color: var(--text-tertiary); font-variant-numeric: tabular-nums; }
  .irow-action { display: inline-flex; align-items: center; }
  /* 移动两行式（§7.2/§10）：主信息一行，元数据+操作一行 */
  @media (max-width: 639px) {
    .irow { flex-wrap: wrap; row-gap: 4px; min-height: 48px; padding: var(--space-3) 0; }
    .irow-main { flex-basis: 100%; }
    .irow-side { width: 100%; justify-content: space-between; }
  }
</style>
