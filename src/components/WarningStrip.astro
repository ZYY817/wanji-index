---
// 风险警示条 —— 克制的 amber 左边框提示（docs/05 §8：左 3px warning 边 + #FCF6EC 底，非红非吓人）
// 用途：风险提示、限免提示条、"原站状态待确认"等警示级信息
interface Props { tone?: 'warning' | 'info' }
const { tone = 'warning' } = Astro.props;
---
<div class:list={['wstrip', tone]} role="note">
  <slot />
</div>
<style>
  .wstrip {
    border-left: 3px solid var(--warning);
    background: var(--warn-strip-bg);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sub);
    line-height: var(--lh-sub);
    color: var(--text-primary);
    border-radius: 0 var(--r-ctl) var(--r-ctl) 0;
  }
  .wstrip.info { border-left-color: var(--info); background: var(--accent-soft); }
</style>
