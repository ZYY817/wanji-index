---
// 文字封面 —— 无图识别方案（docs/05 §2.2/§8：名称首字符+类型色淡底）
// 取字符规则（§13-4）：中文取首字、英文取首字母
interface Props { name: string; size?: 'list' | 'detail' }
const { name, size = 'list' } = Astro.props;
const ch = (name ?? '?').trim().charAt(0).toUpperCase();
---
<span class:list={['tcover', size]} aria-hidden="true">{ch}</span>
<style>
  .tcover {
    flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--accent-soft); color: var(--accent);
    border-radius: var(--r-ctl);
    font-weight: 700;
    font-family: var(--font-zh);
  }
  .list   { width: 40px; height: 40px; font-size: 18px; }
  .detail { width: 88px; height: 88px; font-size: 40px; }
  @media (max-width: 639px) { .detail { width: 64px; height: 64px; font-size: 28px; } }
</style>
