---
import { withBase } from '../lib/url.mjs';
// 顶部导航 —— 高 56px、底 1px 线、当前项 accent+2px 下划线、<640px 汉堡抽屉（docs/05 §8/§10）
import site from '../../config/site.json';
import SearchBar from './SearchBar.astro';

const NAV = [
  { href: withBase('/games/'), label: '游戏库' },
  { href: withBase('/free/'), label: '免费' },
  { href: withBase('/resources/'), label: '资源站' },
  { href: withBase('/tools/'), label: '工具' },
  { href: withBase('/guides/'), label: '教程' },
];
const cur = Astro.url.pathname;
const isCur = (h: string) => cur === h || cur.startsWith(h);
---
<header class="site-header">
  <div class="hd-inner container container-index">
    <a class="hd-logo" href={withBase('/')}>{site.name}</a>
    <nav class="hd-nav" aria-label="主导航">
      {NAV.map((n) => <a class:list={['hd-item', { cur: isCur(n.href) }]} href={n.href}>{n.label}</a>)}
    </nav>
    <div class="hd-search"><SearchBar variant="inline" placeholder="搜索…" /></div>
    <button class="hd-burger" aria-label="打开菜单" aria-expanded="false" data-burger><span></span><span></span><span></span></button>
  </div>
</header>

<!-- 移动抽屉（选中即生效导航；遮罩 40%） -->
<div class="drawer-mask" data-mask hidden></div>
<nav class="drawer" aria-label="移动端导航" data-drawer hidden>
  <div class="drawer-search"><SearchBar variant="inline" placeholder="搜游戏名、报错、工具…" /></div>
  {NAV.map((n) => <a class:list={['drawer-item', { cur: isCur(n.href) }]} href={n.href}>{n.label}</a>)}
  <a class="drawer-item" href={withBase('/about/')}>关于</a>
  <button class="drawer-close" data-close>收起</button>
</nav>

<script>
  const burger = document.querySelector('[data-burger]');
  const drawer = document.querySelector('[data-drawer]');
  const mask = document.querySelector('[data-mask]');
  const close = document.querySelector('[data-close]');
  const set = (open: boolean) => {
    drawer?.toggleAttribute('hidden', !open);
    mask?.toggleAttribute('hidden', !open);
    burger?.setAttribute('aria-expanded', String(open));
    burger?.classList.toggle('open', open);
  };
  burger?.addEventListener('click', () => set(burger.getAttribute('aria-expanded') !== 'true'));
  mask?.addEventListener('click', () => set(false));
  close?.addEventListener('click', () => set(false));
</script>

<style>
  .site-header {
    height: var(--nav-h);
    background: var(--bg-raised);
    border-bottom: 1px solid var(--border);
    position: sticky; top: 0; z-index: 50;
  }
  .hd-inner { display: flex; align-items: center; gap: var(--space-5); height: 100%; }
  .hd-logo { font-weight: 700; font-size: 17px; color: var(--text-primary); white-space: nowrap; }
  .hd-logo:hover { text-decoration: none; color: var(--accent); }
  .hd-nav { display: flex; gap: var(--space-5); flex: 1; }
  .hd-item {
    color: var(--text-secondary); font-size: var(--fs-sub);
    height: var(--nav-h); display: inline-flex; align-items: center;
    border-bottom: 2px solid transparent;
  }
  .hd-item:hover { color: var(--text-primary); text-decoration: none; }
  .hd-item.cur { color: var(--accent); border-bottom-color: var(--accent); font-weight: 500; }
  .hd-search { width: 240px; }
  .hd-burger {
    display: none;
    width: 44px; height: 44px;
    border: 0; background: none; cursor: pointer;
    flex-direction: column; align-items: center; justify-content: center; gap: 5px;
  }
  .hd-burger span { display: block; width: 20px; height: 1.5px; background: var(--text-primary); transition: transform 160ms var(--ease), opacity 160ms var(--ease); }
  .hd-burger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .hd-burger.open span:nth-child(2) { opacity: 0; }
  .hd-burger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
  .drawer-mask {
    position: fixed; inset: 0; z-index: 60;
    background: rgba(29, 33, 41, .4);
    animation: fade 180ms var(--ease);
  }
  .drawer {
    position: fixed; top: 0; left: 0; bottom: 0; z-index: 61;
    width: 280px; max-width: 85vw;
    background: var(--bg-raised);
    box-shadow: var(--shadow-overlay);
    padding: var(--space-4);
    display: flex; flex-direction: column;
    animation: slidein 180ms var(--ease);
  }
  @keyframes slidein { from { transform: translateX(-100%); } to { transform: none; } }
  @keyframes fade { from { opacity: 0; } }
  .drawer-search { margin-bottom: var(--space-4); }
  .drawer-item {
    display: flex; align-items: center;
    min-height: 44px; padding: 0 var(--space-3);
    color: var(--text-secondary); font-size: var(--fs-body);
    border-bottom: 1px solid var(--border);
  }
  .drawer-item.cur { color: var(--accent); font-weight: 500; }
  .drawer-item:hover { text-decoration: none; color: var(--accent); }
  .drawer-close {
    margin-top: auto; min-height: 44px;
    border: 1px solid var(--border-control); border-radius: var(--r-ctl);
    background: var(--bg-raised); color: var(--text-secondary);
    font-size: var(--fs-sub); cursor: pointer; font-family: inherit;
  }
  @media (max-width: 639px) {
    .hd-nav, .hd-search { display: none; }
    .hd-burger { display: flex; margin-left: auto; }
  }
</style>
