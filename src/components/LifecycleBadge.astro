---
// 生命周期徽标 —— 一律实心胶囊（docs/05 §9 双轨规则：生命周期=实心轨）
// 用法：<LifecycleBadge state={computeLifecycle(offer, now, staleDays)} />
// state 与 src/lib/lifecycle.mjs 返回值一一对应；permanent/opensource 传 null 时不渲染
interface Props { state: 'active' | 'upcoming' | 'ended' | 'deadline_unknown' | 'uncertain' | null }
const MAP = {
  active:           { label: '进行中',     color: 'var(--success)' },
  upcoming:         { label: '未开始',     color: 'var(--info)' },
  ended:            { label: '已结束',     color: 'var(--neutral-badge)' },
  deadline_unknown: { label: '截止不明',   color: 'var(--warning)' },
  uncertain:        { label: '状态待确认', color: 'var(--warning)' },
} as const;
const { state } = Astro.props;
const cfg = state ? MAP[state] : null;
---
{cfg && <span class="lc-badge" style={`background:${cfg.color}`}>{cfg.label}</span>}
<style>
  .lc-badge {
    display: inline-block;
    padding: 3px 8px;
    border-radius: var(--r-pill);
    color: #fff;
    font-size: var(--fs-badge);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
  }
</style>
