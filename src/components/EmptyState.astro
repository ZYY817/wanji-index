---
// 空状态 —— 居中：说明句+条件摘要+清除+收录去向（docs/05 §8）
// 与"索引加载失败"错误态是不同组件（§7.9：两态绝不混用）
interface Props { message: string; clearHref?: string; submitHref?: string }
const { message, clearHref, submitHref } = Astro.props;
---
<div class="empty">
  <p class="empty-msg">{message}</p>
  <div class="empty-extra"><slot /></div>
  <div class="empty-acts">
    {clearHref && <a href={clearHref}>清除全部条件</a>}
    {submitHref && <a href={submitHref}>提交收录请求 ↗</a>}
  </div>
</div>
<style>
  .empty { padding: var(--space-7) 0; text-align: center; }
  .empty-msg { font-size: var(--fs-sub); color: var(--text-secondary); margin-bottom: var(--space-3); }
  .empty-extra { margin-bottom: var(--space-3); }
  .empty-acts { display: inline-flex; gap: var(--space-5); font-size: var(--fs-sub); }
</style>
