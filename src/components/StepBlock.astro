---
// 教程步骤块 —— 编号圆+action/expected/ifFail 三行+verified 描边徽标（docs/05 §7.8/§8）
import StatusBadge from './StatusBadge.astro';
interface Props {
  n: number;
  step: { title?: string; action: string; expected: string; ifFail: string; verified?: string };
}
const { n, step } = Astro.props;
---
<div class="step">
  <div class="step-num" aria-hidden="true">{n}</div>
  <div class="step-body">
    {step.title && <h3 class="step-title">{step.title}</h3>}
    <p><span class="step-k">操作：</span>{step.action}</p>
    <p><span class="step-k">预期：</span>{step.expected}</p>
    <p class="step-fail"><span class="step-k">若未解决 →</span> {step.ifFail}</p>
    {step.verified && <StatusBadge kind={step.verified} />}
  </div>
</div>
<style>
  .step { display: flex; gap: var(--space-4); padding: var(--space-5) 0; border-bottom: 1px solid var(--border); }
  .step-num {
    flex-shrink: 0;
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--accent); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: var(--fs-sub); font-weight: 600;
  }
  .step-body { flex: 1; min-width: 0; }
  .step-body p { margin: 0 0 var(--space-2); font-size: var(--fs-sub); }
  .step-title { margin-bottom: var(--space-2); }
  .step-k { color: var(--text-secondary); font-weight: 500; }
  .step-fail { color: var(--text-secondary); }
</style>
