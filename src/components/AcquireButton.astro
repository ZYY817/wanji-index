---
// 实色主按钮 —— 仅限「获取/领取」类动作（docs/05 §8：游戏渠道/限免领取/工具官方下载）
// 站内导航/官网访问禁用本组件，请用 OutlineButton 或 ExtLink
import StatusBadge from './StatusBadge.astro';
interface Props {
  href: string;
  label?: string;           // 默认「前往」
  health?: 'ok' | 'unchecked' | 'suspect' | 'dead';
}
const { href, label = '前往', health = 'ok' } = Astro.props;
const dead = health === 'dead';
---
<span class="acq">
  {dead
    ? <span class="acq-btn acq-dead" aria-disabled="true">{label} ↗</span>
    : <a class="acq-btn" href={href} target="_blank" rel="noopener noreferrer">{label} ↗</a>}
  {health === 'suspect' && <StatusBadge kind="suspect" />}
  {dead && <StatusBadge kind="dead" />}
</span>
<style>
  .acq { display: inline-flex; align-items: center; gap: 8px; }
  .acq-btn {
    display: inline-flex; align-items: center; justify-content: center;
    height: 36px; padding: 0 16px;
    background: var(--accent); color: #fff;
    border-radius: var(--r-ctl);
    font-size: var(--fs-sub); font-weight: 500;
    transition: background var(--dur) var(--ease);
    text-decoration: none !important;
  }
  .acq-btn:hover { background: var(--accent-hover); }
  .acq-dead { background: var(--bg-sunken); color: var(--text-tertiary); text-decoration: line-through; cursor: not-allowed; }
  /* 移动：整宽 H48（§10.2） */
  @media (max-width: 639px) {
    .acq { width: 100%; }
    .acq-btn { height: 48px; flex: 1; }
  }
</style>
