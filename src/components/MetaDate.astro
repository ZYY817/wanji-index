---
// 核验日期行 —— mono「核验于 YYYY-MM-DD」tertiary；超阈值时追加「久未核验」描边徽标（docs/05 §8/§9）
import StatusBadge from './StatusBadge.astro';
interface Props {
  checkedAt: string;
  staleDays?: number;   // 传入时自动判 stale；不传仅显示日期
  now?: number;
}
const { checkedAt, staleDays, now = Date.now() } = Astro.props;
const stale = staleDays != null
  ? now > Date.parse(checkedAt + 'T00:00:00+08:00') + staleDays * 864e5
  : false;
---
<span class="metadate meta mono">
  核验于 <time datetime={checkedAt}>{checkedAt}</time>
  {stale && <StatusBadge kind="stale" />}
</span>
<style>
  .metadate { display: inline-flex; align-items: center; gap: 6px; }
</style>
