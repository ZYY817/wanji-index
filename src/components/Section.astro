---
// 分节 —— 详情页/索引页模块容器（docs/05 D1：小节标题+细分隔线+留白）
// 无数据时由调用方整体不渲染（模块隐藏规则），本组件不做假占位
interface Props { title?: string; id?: string }
const { title, id } = Astro.props;
---
<section class="sect" id={id}>
  {title && <h2 class="sect-title">{title}</h2>}
  <div class="sect-body"><slot /></div>
</section>
<style>
  .sect { margin-top: var(--space-7); }
  .sect:first-child { margin-top: 0; }
  .sect-title { padding-bottom: var(--space-3); border-bottom: 1px solid var(--border); margin-bottom: var(--space-5); }
</style>
