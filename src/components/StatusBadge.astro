---
// 状态徽标 —— 一律描边胶囊（docs/05 §9：链接健康/核验/数据状态=描边轨）
// kind：
//   linkHealth: ok→不渲染(§9 正常无徽标) | unchecked→待核验 | suspect→疑似失效 | dead→已失效
//   reviewStatus: unverified→待核验 | stale→久未核验（checkedAt 超阈值时由调用方传入）
//   stepVerified: self→亲测 | community→社区方案未核验 | unverified→未核验
interface Props { kind: string }
const MAP: Record<string, { label: string; color: string } | null> = {
  // linkHealth
  ok: null,
  unchecked:  { label: '待核验',   color: 'var(--neutral-badge)' },
  suspect:    { label: '疑似失效', color: 'var(--warning)' },
  dead:       { label: '已失效',   color: 'var(--danger)' },
  // 核验
  unverified: { label: '待核验',   color: 'var(--neutral-badge)' },
  stale:      { label: '久未核验', color: 'var(--warning)' },
  // 步骤核验（§7.8 描边）
  self:       { label: '亲测',           color: 'var(--success)' },
  community:  { label: '社区方案未核验', color: 'var(--warning)' },
};
const { kind } = Astro.props;
const cfg = MAP[kind] === undefined ? { label: kind, color: 'var(--neutral-badge)' } : MAP[kind];
---
{cfg && <span class="st-badge" style={`border-color:${cfg.color};color:${cfg.color}`}>{cfg.label}</span>}
<style>
  .st-badge {
    display: inline-block;
    padding: 3px 8px;
    border: 1px solid;
    border-radius: var(--r-pill);
    background: transparent;
    font-size: var(--fs-badge);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
  }
</style>
