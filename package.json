{
  "name": "wanji-index",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "玩机索引——中文 PC 游戏资源与工具索引站（静态站）",
  "scripts": {
    "dev": "astro dev",
    "validate": "node scripts/validate.mjs",
    "build": "npm run validate && astro build && npm run check:artifacts",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "build:test": "node scripts/build-test.mjs",
    "test": "node scripts/test-lifecycle.mjs && node scripts/test-validate.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "astro": "7.4.2",
    "@astrojs/sitemap": "3.7.4",
    "ajv": "8.20.0"
  }
}
