{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Problem（问题排查）：按症状组织，列出从易到难的几种解法，每种解法注明来源",
  "type": "object",
  "required": ["id", "slug", "title", "category", "summary", "fixes", "reviewStatus", "checkedAt", "createdAt", "updatedAt", "publishStatus"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1, "description": "玩家会怎么搜：「游戏闪退」「提示缺少 dll」" },
    "short": { "type": "string", "description": "索引页上的短名" },
    "titleEn": { "type": "string" },
    "shortEn": { "type": "string" },
    "summaryEn": { "type": "string" },
    "category": { "type": "string", "x-enum": "problemCategory" },
    "summary": { "type": "string", "minLength": 1, "description": "一句话结论：最常见的原因与最先该试的办法" },
    "symptoms": { "type": "array", "items": { "type": "string" }, "description": "具体表现，帮玩家确认是不是这个问题" },
    "errorTexts": { "type": "array", "items": { "type": "string" }, "description": "常见报错原文（进搜索索引）" },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "fixes": {
      "type": "array",
      "minItems": 1,
      "description": "解法，按「先试哪个」排序：越靠前越常见、越省事",
      "items": {
        "type": "object",
        "required": ["title", "detail"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1, "description": "本站自己写的说明，不转载原文" },
          "when": { "type": "string", "description": "什么情况下优先试这个" },
          "guideId": { "type": "string", "description": "站内有分步教程时链接过去" },
          "sources": { "type": "array", "items": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": "string", "pattern": "^https?://" } }, "additionalProperties": false } }
        },
        "additionalProperties": false
      }
    },
    "table": {
      "type": "object",
      "description": "可选的速查表（如「缺哪个 dll → 装什么」）",
      "required": ["columns", "rows"],
      "properties": {
        "caption": { "type": "string" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "avoid": { "type": "array", "items": { "type": "string" }, "description": "不建议的做法（如从 dll 下载站单独下载文件）" },
    "issueMatch": { "type": "array", "items": { "type": "string" }, "description": "匹配各游戏已知问题标题的关键词（小写英文，PCGamingWiki 用英文）" },
    "relatedProblems": { "type": "array", "items": { "type": "string" } },
    "reviewStatus": { "type": "string", "x-enum": "reviewStatus" },
    "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "publishStatus": { "type": "string", "x-enum": "publishStatus" },
    "_demo": { "type": "boolean" }
  }
}
