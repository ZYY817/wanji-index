{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Guide（docs/04 §2.5）",
  "type": "object",
  "required": ["id", "slug", "title", "kind", "category", "steps", "sources", "reviewStatus", "checkedAt", "createdAt", "updatedAt", "publishStatus"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "x-enum": "guideKind" },
    "category": { "type": "string", "x-enum": "guideCategory" },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "problem": {
      "type": "object",
      "properties": { "description": { "type": "string" }, "errorText": { "type": "string" }, "conditions": { "type": "string" } }
    },
    "games": { "type": "array", "items": { "type": "string" } },
    "gameVersions": { "type": "string" },
    "os": { "type": "array", "items": { "type": "string", "x-enum": "os" } },
    "osVersions": { "type": "array", "items": { "type": "string", "x-enum": "osVersions" } },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "expected", "ifFail"],
        "properties": {
          "title": { "type": "string" },
          "action": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 },
          "ifFail": { "type": "string", "minLength": 1 },
          "verified": { "type": "string", "x-enum": "stepVerified" }
        }
      }
    },
    "recovery": { "type": "array", "items": { "type": "string" } },
    "tools": { "type": "array", "items": { "type": "string" } },
    "relatedGuides": { "type": "array", "items": { "type": "string" } },
    "relatedEntries": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": "string", "pattern": "^https?://" } } } },
    "reviewStatus": { "type": "string", "x-enum": "reviewStatus" },
    "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "publishStatus": { "type": "string", "x-enum": "publishStatus" },
    "seo": { "type": "object", "properties": { "title": { "type": "string" }, "description": { "type": "string" } } },
    "_demo": { "type": "boolean" }
  }
}
