{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResourceEntry（docs/04 §2.3）",
  "type": "object",
  "required": ["id", "name", "type", "siteId", "url", "linkHealth", "checkedAt", "publishStatus"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "x-enum": "entryType" },
    "siteId": { "type": "string", "minLength": 1 },
    "gameId": { "type": "string" },
    "url": { "type": "string", "pattern": "^https?://" },
    "note": { "type": "string" },
    "gameVersion": { "type": "string" },
    "platformNote": { "type": "string" },
    "languages": { "type": "array", "items": { "type": "string" } },
    "restrictions": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "linkHealth": { "type": "string", "x-enum": "linkHealth" },
    "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sources": { "type": "array", "items": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": "string", "pattern": "^https?://" } } } },
    "publishStatus": { "type": "string", "x-enum": "publishStatus" },
    "_demo": { "type": "boolean" }
  }
}
