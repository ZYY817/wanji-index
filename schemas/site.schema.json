{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResourceSite（docs/04 §2.2）",
  "type": "object",
  "required": ["id", "slug", "name", "summary", "category", "url", "linkHealth", "reviewStatus", "checkedAt", "createdAt", "updatedAt", "publishStatus"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "category": { "type": "string", "x-enum": "siteCategory" },
    "url": { "type": "string", "pattern": "^https?://" },
    "languages": { "type": "array", "items": { "type": "string" } },
    "feeNote": { "type": "string" },
    "purposes": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "linkHealth": { "type": "string", "x-enum": "linkHealth" },
    "reviewStatus": { "type": "string", "x-enum": "reviewStatus" },
    "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sources": { "type": "array", "items": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": "string", "pattern": "^https?://" } } } },
    "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "publishStatus": { "type": "string", "x-enum": "publishStatus" },
    "seo": { "type": "object", "properties": { "title": { "type": "string" }, "description": { "type": "string" } } },
    "_demo": { "type": "boolean" }
  }
}
