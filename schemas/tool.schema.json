{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tool（docs/04 §2.4）",
  "type": "object",
  "required": ["id", "slug", "name", "type", "summary", "officialUrl", "linkHealth", "reviewStatus", "checkedAt", "createdAt", "updatedAt", "publishStatus"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "type": { "type": "string", "x-enum": "toolType" },
    "summary": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "os": { "type": "array", "items": { "type": "string", "x-enum": "os" } },
    "osVersions": { "type": "array", "items": { "type": "string", "x-enum": "osVersions" } },
    "supportedGames": { "type": "array", "items": { "type": "string" } },
    "officialUrl": { "type": "string", "pattern": "^https?://" },
    "officialSiteId": { "type": "string" },
    "version": { "type": "object", "properties": { "latest": { "type": "string" }, "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } } },
    "compatibility": { "type": "string" },
    "installNotes": { "type": "string" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "uninstallNote": { "type": "string" },
    "linkHealth": { "type": "string", "x-enum": "linkHealth" },
    "reviewStatus": { "type": "string", "x-enum": "reviewStatus" },
    "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sources": { "type": "array", "items": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": "string", "pattern": "^https?://" } } } },
    "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "publishStatus": { "type": "string", "x-enum": "publishStatus" },
    "seo": { "type": "object", "properties": { "title": { "type": "string" }, "description": { "type": "string" } } },
    "_demo": { "type": "boolean" }
  }
}
