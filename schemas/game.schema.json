{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Game（docs/04 §2.1）",
  "type": "object",
  "required": ["id", "slug", "name", "summary", "channels", "sources", "reviewStatus", "checkedAt", "createdAt", "updatedAt", "publishStatus"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": {
      "type": "object",
      "required": ["zh"],
      "properties": { "zh": { "type": "string", "minLength": 1 }, "en": { "type": "string" } },
      "additionalProperties": false
    },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "genres": { "type": "array", "items": { "type": "string" } },
    "os": { "type": "array", "items": { "type": "string", "x-enum": "os" } },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["platform", "type", "url"],
        "properties": {
          "platform": { "type": "string", "x-enum": "platform" },
          "type": { "type": "string", "x-enum": "channelType" },
          "url": { "type": "string", "pattern": "^https?://" },
          "priceNote": { "type": "string" },
          "linkHealth": { "type": "string", "x-enum": "linkHealth" },
          "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "cover": {
      "type": "object",
      "properties": {
        "type": { "enum": ["text", "placeholder", "image"] },
        "src": { "type": "string" },
        "alt": { "type": "string" }
      }
    },
    "savePaths": { "type": "array", "items": { "type": "object", "required": ["path"], "properties": { "os": { "type": "string", "x-enum": "os" }, "path": { "type": "string" }, "note": { "type": "string" } } } },
    "configPaths": { "type": "array", "items": { "type": "object", "required": ["path"], "properties": { "os": { "type": "string", "x-enum": "os" }, "path": { "type": "string" }, "note": { "type": "string" } } } },
    "faqs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question"],
        "properties": { "question": { "type": "string", "minLength": 1 }, "answer": { "type": "string" }, "guideId": { "type": "string" } }
      }
    },
    "relatedGameIds": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": "string", "pattern": "^https?://" } } } },
    "reviewStatus": { "type": "string", "x-enum": "reviewStatus" },
    "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "publishStatus": { "type": "string", "x-enum": "publishStatus" },
    "seo": { "type": "object", "properties": { "title": { "type": "string" }, "description": { "type": "string" } } },
    "_demo": { "type": "boolean" }
  }
}
